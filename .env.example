# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required to run the scorer or the benchmark CLI for real: a Mistral AI API key.
# Get one at https://console.mistral.ai
SCORER_MISTRAL_API_KEY=

# Optional overrides (defaults shown):
# SCORER_DATABASE_URL=sqlite:///./scorer.db
# SCORER_JUDGE_MODEL=mistral-large-latest
